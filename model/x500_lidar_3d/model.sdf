<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_lidar_3d'>

    <!-- Base frame only — no sensors -->
    <include merge='true'>
      <uri>x500_base</uri>
    </include>

    <!-- 3D lidar sensor model -->
    <include merge='true'>
      <uri>lidar_3d</uri>
      <pose>.12 0 .26 0 0 0</pose>
    </include>

    <!-- Attach lidar rigidly to drone body -->
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>link</child>
    </joint>

  </model>
</sdf>